{
  "name": "agent-fleet-dsh",
  "version": "1.0.0",
  "private": true,
  "description": "DSH desktop plugin: native session endpoints on a Unix socket for the Agenvo dsh connector.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": { "default": "./index.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "native-bridge.js", "cordis.patch.yml", "locale"],
  "engines": { "node": ">=20", "dsh": ">=0.2.0-rc.2" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=0.2.0-rc.2 <0.3.0-0" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "harnessRange": ">=0.2.0-rc.2"
  },
  "license": "Apache-2.0"
}
