# syntax=docker/dockerfile:1
# Multi-stage build for Agent-Fleet Unified Workbench Server (Alibaba Cloud ECS)
FROM node:22-alpine AS web-builder
WORKDIR /build/web
RUN mkdir -p /srv/workbench/static && \
    printf '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Agent-Fleet Workbench</title></head><body><div id="app">Agent-Fleet Unified Workbench</div></body></html>\n' > /srv/workbench/static/index.html

FROM rust:1.85-bookworm AS rust-builder
WORKDIR /usr/src/agent-fleet
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p fleet-workbench-server -p fleet-cli

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsqlite3-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=web-builder /srv/workbench/static /srv/workbench/static
COPY --from=rust-builder /usr/src/agent-fleet/target/release/fleet-workbench-server /usr/local/bin/fleet-workbench-server
COPY --from=rust-builder /usr/src/agent-fleet/target/release/fleet-cli /usr/local/bin/fleet-cli

ENV WORKBENCH_BIND_ADDR=0.0.0.0:5174
ENV FLEET_STATE_ROOT=/var/lib/agent-fleet/state
ENV FLEET_PROJECTS_ROOT=/var/lib/agent-fleet/projects
EXPOSE 5174
VOLUME ["/var/lib/agent-fleet/state", "/var/lib/agent-fleet/projects"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5174/api/v2/health || exit 1
ENTRYPOINT ["/usr/local/bin/fleet-workbench-server"]
