+
+test("session-only selection requires live capability and never falls back", async (t) => {
+  const dir = await mkdtemp(join(socketTempDir(), "agenvo-selection-"));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const socket = join(dir, "native.sock");
+  const native = await desktop(socket);
+  t.after(native.close);
+  const make = () =>
+    new DshAdapter(
+      instanceConfigSchema.parse({
+        id: "dsh-test",
+        label: "DSH",
+        kind: "dsh",
+        endpoint: "unix://" + socket,
+      }),
+    );
+  const name = "session/selectModelForSession";
+  const params = {
+    request: {
+      sessionId: "session-test",
+      provider: "provider",
+      model: "model",
+      reasoningEffort: "high",
+    },
+  };
+  const old = make();
+  t.after(() => old.close());
+  await old.init();
+  assert.equal(
+    old.methods().some((m) => m.name === name),
+    false,
+  );
+  assert.equal((await old.call(name, params)).execution, "not_started");
+  assert.equal(native.calls.filter((c) => c.endpoint === name).length, 0);
+  await old.close();
+  native.capability(true);
+  const patched = make();
+  t.after(() => patched.close());
+  await patched.init();
+  assert.equal(
+    patched.methods().some((m) => m.name === name),
+    true,
+  );
+  const outcome = await patched.call(name, params);
+  assert.equal(outcome.execution, "accepted");
+  assert.deepEqual(outcome.result, {
+    selected: params.request,
+    scope: "session",
+    status: "applied",
+    seq: 3,
+  });
+  assert.deepEqual(native.calls.find((c) => c.endpoint === name)?.args, params);
+  native.drop("session/modelCatalog");
+  assert.equal((await patched.call(name, params)).execution, "not_started");
+  assert.equal(
+    patched.methods().some((m) => m.name === name),
+    false,
+  );
+  assert.equal(native.calls.filter((c) => c.endpoint === name).length, 1);
+  native.capability("true");
+  assert.equal((await patched.call(name, params)).execution, "not_started");
+  assert.equal(
+    patched.methods().some((m) => m.name === name),
+    false,
+  );
+  native.capability(true);
+  native.drop(name);
+  const lost = await patched.call(name, params);
+  assert.equal(lost.execution, "unknown");
+  assert.equal(native.calls.filter((c) => c.endpoint === name).length, 2);
+  assert.equal(
+    native.calls.filter((c) => c.endpoint === "session/selectModel").length,
+    0,
+  );
+  await patched.close();
+  assert.equal(
+    patched.methods().some((m) => m.name === name),
+    false,
+  );
+});
