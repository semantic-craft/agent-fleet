+test("probe CLI config maps scope and descriptor fingerprints cannot reuse approval", async () => {
+  const { backend } = await import("../apps/codex-app-server/src/backend.js");
+  const { descriptor } = await import("@agenvo/connector/config");
+  const config = await backend.configure(
+    {
+      id: "probe",
+      home: process.cwd(),
+      cwd: process.cwd(),
+      endpoint: "unix:///fixture/no-server.sock",
+      "handoff-probe-thread-id": "test-thread",
+    },
+    process.cwd(),
+  );
+  assert.equal(config.handoffProbeThreadId, "test-thread");
+  assert.equal(backend.revision(config), "codex-0.164.0-handoff-probe-v1");
+  const policy = backend.executionPolicyForConfig!(config);
+  assert.equal(policy?.execution, "read-only-handoff-probe");
+  const first = await descriptor(
+    config,
+    false,
+    "fixture",
+    "probe",
+    policy?.execution,
+  );
+  const changed = { ...config, handoffProbeThreadId: "different-thread" };
+  const second = await descriptor(
+    changed,
+    false,
+    "fixture",
+    "probe",
+    policy?.execution,
+  );
+  assert.notEqual(first.fingerprint, second.fingerprint);
+  assert.equal(first.scope.execution, "read-only-handoff-probe");
+  assert.equal(first.scope.handoffProbeThreadId, "test-thread");
+  const legacy = { ...config };
+  delete legacy.handoffProbeThreadId;
+  assert.equal(backend.executionPolicyForConfig!(legacy), undefined);
+  assert.equal(backend.revision(legacy), "codex-0.160.1-attach-native-v1");
+  const old = await descriptor(legacy, false, "fixture", "probe");
+  assert.equal(old.scope.execution, "full-access");
+  assert.notEqual(first.fingerprint, old.fingerprint);
+});
