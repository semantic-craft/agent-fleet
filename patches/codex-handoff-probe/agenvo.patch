diff --git a/apps/codex-app-server/src/handoff-probe.ts b/apps/codex-app-server/src/handoff-probe.ts
new file mode 100644
index 0000000..e44f9b6
--- /dev/null
+++ b/apps/codex-app-server/src/handoff-probe.ts
@@ -0,0 +1,85 @@
+import { z } from "zod";
+import { Fault } from "@agenvo/protocol";
+import type { Method } from "@agenvo/connector/adapters/adapter";
+import { methodValidators, validate } from "./native-schema.js";
+
+// Native unsubscribe request shape from Codex CLI 0.164.0 generated schema.
+// It removes this connection's subscription, not ownership: the last subscriber
+// triggers unload only after the server's inactivity grace period (30 minutes).
+function inputs(threadId: string) {
+  const id = z.literal(threadId);
+  const readonly = { approvalPolicy: z.literal("never") };
+  return {
+    "thread/read": z.strictObject({
+      threadId: id,
+      includeTurns: z.literal(false).optional(),
+    }),
+    "thread/turns/list": z.strictObject({
+      threadId: id,
+      cursor: z.string().optional(),
+      limit: z.number().int().min(1).max(50),
+    }),
+    "thread/items/list": z.strictObject({
+      threadId: id,
+      turnId: z.string().optional(),
+      cursor: z.string().optional(),
+      limit: z.number().int().min(1).max(50),
+    }),
+    "thread/resume": z.strictObject({
+      threadId: id,
+      ...readonly,
+      sandbox: z.literal("read-only"),
+      excludeTurns: z.literal(true),
+    }),
+    "turn/start": z.strictObject({
+      threadId: id,
+      ...readonly,
+      sandboxPolicy: z.strictObject({
+        type: z.literal("readOnly"),
+        networkAccess: z.literal(false),
+      }),
+      input: z
+        .array(
+          z.strictObject({
+            type: z.literal("text"),
+            text: z.string().min(1).max(8192),
+          }),
+        )
+        .min(1)
+        .max(1),
+    }),
+    "thread/unsubscribe": z.strictObject({ threadId: id }),
+    "notifications.list": z.strictObject({
+      threadId: id,
+      cursor: z.string().optional(),
+      limit: z.number().int().min(1).max(50).optional(),
+    }),
+  };
+}
+export function probeMethods(threadId: string): Method[] {
+  return Object.entries(inputs(threadId)).map(([name, schema]) => ({
+    name,
+    readOnly: /(?:\/list|\/read|\.list)$/.test(name),
+    inputSchema: z.toJSONSchema(schema),
+    description:
+      name === "thread/unsubscribe"
+        ? "Unsubscribe this connection from the designated test thread. Not proof of writer release; no auto-resume, retry, or fallback."
+        : `Scoped handoff probe: ${name}; designated test thread only. Explicit read-only sandbox required for submit input/resume. No automatic approvals.`,
+  }));
+}
+export function probeParams(
+  threadId: string,
+  method: string,
+  original: Record<string, unknown>,
+): Record<string, unknown> {
+  const schemas = inputs(threadId);
+  const schema = schemas[method as keyof typeof schemas];
+  if (!schema) throw new Fault("unsupported_method");
+  const parsed = schema.safeParse(original);
+  if (!parsed.success)
+    throw new Fault("invalid_params", "Outside scoped handoff probe contract");
+  const params = parsed.data;
+  const native = methodValidators.get(method);
+  if (native) validate(native, params);
+  return structuredClone(params);
+}
