@@ -0,0 +1,327 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { CodexAdapter } from "../apps/codex-app-server/src/codex.js";
+import { instanceConfigSchema } from "../apps/codex-app-server/src/config.js";
+import { executionParams } from "../apps/codex-app-server/src/codex-execution.js";
+
+function fixture() {
+  const calls: any[] = [],
+    writes: any[] = [],
+    events: any[] = [];
+  let receive!: (p: any) => void;
+  let disconnect!: () => void;
+  let failUnsubscribe = false;
+  const config = instanceConfigSchema.parse({
+    id: "probe",
+    label: "Probe",
+    kind: "codex",
+    cwd: process.cwd(),
+    home: process.cwd(),
+    endpoint: "unix:///fixture/no-server.sock",
+    handoffProbeThreadId: "test-thread",
+  });
+  const transport: any = {
+    isOpen: true,
+    open: async () => {},
+    close: () => {},
+    write: (p: any) => writes.push(p),
+    rpc: async (method: string, params: any) => {
+      calls.push({ method, params });
+      if (method === "initialize")
+        return { userAgent: "fixture/0.164.0", codexHome: process.cwd() };
+      if (method === "thread/unsubscribe" && failUnsubscribe)
+        throw Error("unknown unsubscribe");
+      if (method === "thread/unsubscribe") return { status: "unsubscribed" };
+      if (method === "thread/read" || method === "thread/resume")
+        return { thread: { id: "test-thread", status: { type: "idle" } } };
+      return {};
+    },
+  };
+  const adapter = new CodexAdapter(config, ((_c: any, r: any, d: any) => {
+    receive = r;
+    disconnect = d;
+    return transport;
+  }) as any);
+  return {
+    adapter,
+    calls,
+    writes,
+    events,
+    config,
+    send: (p: any) => receive(p),
+    disconnect: () => disconnect(),
+    failUnsubscribe: () => {
+      failUnsubscribe = true;
+    },
+  };
+}
+const resume = {
+  threadId: "test-thread",
+  sandbox: "read-only",
+  approvalPolicy: "never",
+  excludeTurns: true,
+};
+const turn = {
+  threadId: "test-thread",
+  approvalPolicy: "never",
+  sandboxPolicy: { type: "readOnly", networkAccess: false },
+  input: [{ type: "text", text: "Return only fixture marker." }],
+};
+
+test("scoped methods cannot create, list all threads, answer requests, or target another thread", async (t) => {
+  const f = fixture();
+  t.after(() => f.adapter.close());
+  await f.adapter.init();
+  const names = f.adapter.methods().map((m) => m.name);
+  assert.deepEqual(names, [
+    "thread/read",
+    "thread/turns/list",
+    "thread/items/list",
+    "thread/resume",
+    "turn/start",
+    "thread/unsubscribe",
+    "notifications.list",
+  ]);
+  for (const method of [
+    "thread/start",
+    "thread/list",
+    "thread/loaded/list",
+    "model/list",
+    "requests.respond",
+    "requests.list",
+    "turn/interrupt",
+  ]) {
+    await assert.rejects(f.adapter.call(method, { threadId: "test-thread" }), {
+      code: "unsupported_method",
+    });
+  }
+  for (const method of names)
+    await assert.rejects(f.adapter.call(method, { threadId: "other-thread" }), {
+      code: "invalid_params",
+    });
+  assert.deepEqual(
+    f.calls.map((c) => c.method),
+    ["initialize"],
+  );
+});
+test("resume and submit preserve explicit readonly permissions and reject override channels", async (t) => {
+  const f = fixture();
+  t.after(() => f.adapter.close());
+  await f.adapter.init();
+  await f.adapter.call("thread/resume", resume);
+  await f.adapter.call("turn/start", turn);
+  assert.deepEqual(f.calls.at(-2).params, resume);
+  assert.deepEqual(f.calls.at(-1).params, turn);
+  for (const params of [
+    { ...resume, sandbox: "danger-full-access" },
+    { ...resume, config: { sandbox_mode: "danger-full-access" } },
+    { threadId: "test-thread" },
+    { ...resume, approvalsReviewer: "auto_review" },
+  ])
+    await assert.rejects(f.adapter.call("thread/resume", params), {
+      code: "invalid_params",
+    });
+  for (const params of [
+    { ...turn, sandboxPolicy: { type: "workspaceWrite" } },
+    { ...turn, sandboxPolicy: { type: "readOnly", networkAccess: true } },
+    { ...turn, approvalPolicy: "on-request" },
+    { ...turn, cwd: "/other" },
+    { ...turn, config: {} },
+  ])
