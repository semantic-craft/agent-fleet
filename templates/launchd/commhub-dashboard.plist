<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CommHub Web Dashboard (127.0.0.1:3000) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL_PREFIX}}.commhub-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.bun/bin/bun</string>
    <string>run</string>
    <string>dev</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PORT</key><string>3000</string>
    <key>ANET_HUB</key><string>http://127.0.0.1:9200</string>
    <key>PATH</key><string>{{HOME}}/.bun/bin:{{BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>{{PROJECTS}}/_forks/agent-network/deploy/dashboard</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/commhub-dashboard/out.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/commhub-dashboard/err.log</string>
</dict>
</plist>
