<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Standalone Codex app-server sharing ~/.codex with Codex Desktop (Desktop's own app-server is stdio-only). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL_PREFIX}}.codex-app-server</string>
  <key>ProgramArguments</key>
  <array><string>{{BIN}}/codex</string><string>app-server</string><string>--listen</string><string>unix://</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_HOME</key><string>{{HOME}}/.codex</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>{{HOME}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/codex-app-server/out.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/codex-app-server/err.log</string>
</dict>
</plist>
