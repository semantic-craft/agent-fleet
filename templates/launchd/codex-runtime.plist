<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Write this template but do not bootstrap it. release codex-runtime replaces the
     entry with an immutable release before the first bootstrap. -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.agent-fleet.codex-runtime</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>{{HOME}}/.local/share/agent-fleet/releases/codex-runtime/uninstalled/adapters/codex-runtime/cli.mjs</string>
    <string>--config</string><string>{{HOME}}/.config/agent-fleet/codex-runtime.json</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/codex-owned-runtime/out.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/codex-owned-runtime/err.log</string>
</dict></plist>
